// go.work — 仅本会话新建的 9 业务包 (都 go 1.22 兼容)。
//
// 老包 (order-core/payment-core 等) 用 go 1.25/1.26 — 它们自己各自 go.mod 跑就行。
// 想跑老包：cd packages/<svc> && GOWORK=off go run ./cmd/server
// 或：先 mv go.work go.work.disabled 临时关 workspace。

go 1.22

use (
	./packages/billing-system
	./packages/payment-gateway
	./packages/dispute-service
	./packages/merchant-webhook
	./packages/refund-engine
	./packages/kyc-service
	./packages/audit-log
	./packages/biz-admin-web
	./packages/payment-mw
	./packages/oauth2-server
)
