{
  "__comment": "SP-AC-7 PROD4: split-payment Grafana dashboard. Import via Grafana UI 或挂 ConfigMap 走 sidecar.",
  "title": "Split-Payment Service",
  "tags": ["payments", "split-payment", "money-flow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "TriggerEvent QPS",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(split_payment_trigger_duration_seconds_count[5m]))",
          "legendFormat": "qps"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Voucher Success Rate (5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(split_payment_voucher_status_total{status=\"success\"}[5m])) / sum(rate(split_payment_voucher_status_total[5m]))",
          "legendFormat": "success%"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reconcile Inconsistencies (24h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(split_payment_reconcile_inconsistencies_total[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Circuit Breakers Open",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(split_payment_circuit_state >= 2)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TriggerEvent Latency p50/p95/p99",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(split_payment_trigger_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(split_payment_trigger_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(split_payment_trigger_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Voucher Status Rate",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(split_payment_voucher_status_total[5m])) by (status)",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox Pending Depth",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "split_payment_outbox_depth",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox Oldest Pending Age (sec)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "split_payment_outbox_oldest_age_seconds",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Accounting RPC Latency (p99)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(split_payment_accounting_rpc_duration_seconds_bucket[5m])) by (le, method, code))",
          "legendFormat": "{{ method }} / {{ code }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB Pool",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "split_payment_db_open_connections",
          "legendFormat": "open"
        },
        {
          "expr": "split_payment_db_in_use_connections",
          "legendFormat": "in_use"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Refund Event Rate",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(split_payment_refund_event_total[5m])) by (outcome)",
          "legendFormat": "{{ outcome }}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "gRPC Server QPS / Errors",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(split_payment_grpc_server_handled_total[5m])) by (method, code)",
          "legendFormat": "{{ method }} / {{ code }}"
        }
      ]
    }
  ]
}
