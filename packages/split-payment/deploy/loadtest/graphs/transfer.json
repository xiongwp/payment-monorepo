{
  "key": "user-internal-transfer-v1",
  "name": "用户内部转账（loadtest 简化版）",
  "version": "1.0.0",
  "status": "active",
  "spec": {
    "scenario": "user_internal_transfer",
    "charge_strategy": "separate",
    "triggers": [
      { "event": "user.transfer" }
    ],
    "guards": [
      { "kind": "amount_min", "value": 1, "msg": "转账金额必须 > 0" }
    ],
    "nodes": [
      {
        "id": "from_wallet",
        "type": "account",
        "label": "付款人钱包",
        "account_id_attr": "from_account"
      },
      {
        "id": "to_wallet",
        "type": "account",
        "label": "收款人钱包",
        "account_id_attr": "to_account"
      }
    ],
    "edges": [
      {
        "from": "from_wallet",
        "to": "to_wallet",
        "kind": "transfer",
        "event_code": "transfer_user_to_user",
        "rule": { "type": "remainder" }
      }
    ]
  }
}
