{
  "title": "api-gateway SLO",
  "tags": ["api-gateway", "payments"],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [{"name": "datasource", "type": "datasource", "query": "prometheus"}]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "5xx rate (5m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "expr": "sum(rate(api_gateway_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(api_gateway_http_requests_total[5m]))"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 2, "type": "timeseries", "title": "Requests by status_code",
      "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8},
      "targets": [{
        "expr": "sum by (status_code) (rate(api_gateway_http_requests_total[1m]))",
        "legendFormat": "{{status_code}}"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "p99 latency by path",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le, path_prefix) (rate(api_gateway_http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{path_prefix}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4, "type": "timeseries", "title": "Auth rejects / Rate limit hits",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(api_gateway_http_auth_rejects_total[1m])", "legendFormat": "auth_rejects"},
        {"expr": "rate(api_gateway_http_rate_limit_hits_total[1m])", "legendFormat": "rate_limit_hits"}
      ]
    }
  ]
}
