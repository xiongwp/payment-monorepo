{
  "title": "user-merchant-core",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["psp","go"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPC throughput by method",
      "gridPos": {"h":8,"w":12,"x":0,"y":0},
      "targets": [{
        "expr": "sum(rate(user_merchant_grpc_request_total[1m])) by (method)",
        "legendFormat": "{{method}}"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPC p50/p95/p99",
      "gridPos": {"h":8,"w":12,"x":12,"y":0},
      "targets": [
        {"expr":"histogram_quantile(0.50, sum(rate(user_merchant_grpc_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p50"},
        {"expr":"histogram_quantile(0.95, sum(rate(user_merchant_grpc_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"},
        {"expr":"histogram_quantile(0.99, sum(rate(user_merchant_grpc_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p99"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate by code",
      "gridPos": {"h":8,"w":12,"x":0,"y":8},
      "targets": [{
        "expr": "sum(rate(user_merchant_grpc_request_total{code!=\"OK\"}[1m])) by (code)",
        "legendFormat": "{{code}}"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {"h":8,"w":12,"x":12,"y":8},
      "targets": [{
        "expr": "sum(rate(user_merchant_cache_lookup_total{result=\"hit\"}[5m])) by (index) / sum(rate(user_merchant_cache_lookup_total[5m])) by (index)",
        "legendFormat": "{{index}}"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB pool (meta)",
      "gridPos": {"h":8,"w":12,"x":0,"y":16},
      "targets": [
        {"expr":"user_merchant_db_pool_open{db=\"meta\"}","legendFormat":"open"},
        {"expr":"user_merchant_db_pool_in_use{db=\"meta\"}","legendFormat":"in_use"},
        {"expr":"user_merchant_db_pool_idle{db=\"meta\"}","legendFormat":"idle"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "KMS RPC",
      "gridPos": {"h":8,"w":12,"x":12,"y":16},
      "targets": [
        {"expr":"sum(rate(user_merchant_kms_rpc_total[1m])) by (op,result)","legendFormat":"{{op}}/{{result}}"}
      ]
    }
  ]
}
