{
  "version": "1.0",
  "scenarios": [
    {
      "id": "approved",
      "match": {},
      "response": {
        "status_code": 200,
        "body": {
          "id": "ch_mock_${request_id}",
          "status": "succeeded",
          "amount": "${amount}",
          "currency": "${currency}",
          "network_ref_no": "vmock_${idempotency_key}",
          "arn": "${random_arn}"
        }
      }
    },
    {
      "id": "declined_insufficient_funds",
      "match": { "amount_gt": 1000000 },
      "response": {
        "status_code": 200,
        "body": {
          "id": "ch_mock_${request_id}",
          "status": "declined",
          "decline_code": "insufficient_funds",
          "decline_reason": "Card issuer reports insufficient funds"
        }
      }
    },
    {
      "id": "do_not_honor",
      "match": { "source_last4": "0002" },
      "response": {
        "status_code": 200,
        "body": {
          "status": "declined",
          "decline_code": "do_not_honor",
          "decline_reason": "Issuer declined for fraud risk"
        }
      }
    },
    {
      "id": "network_timeout",
      "match": { "header.X-Mock-Scenario": "timeout" },
      "response": { "delay_ms": 60000, "status_code": 200 }
    },
    {
      "id": "network_5xx",
      "match": { "header.X-Mock-Scenario": "5xx" },
      "response": { "status_code": 503, "body": { "error": "service unavailable" } }
    },
    {
      "id": "3ds_challenge",
      "match": { "amount_range": [50, 100] },
      "response": {
        "status_code": 200,
        "body": {
          "status": "requires_action",
          "next_action": {
            "type": "redirect_to_url",
            "redirect_url": "https://3ds-challenge.mock.example.com/v1/${request_id}"
          }
        }
      }
    }
  ]
}
